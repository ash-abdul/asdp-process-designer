{
  "name": "asdp-process-designer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "ASDP Process Designer \u2014 requirements-driven Camunda 8 process application generator",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "clean": "rm -rf packages/*/dist apps/*/dist packages/*/*.tsbuildinfo apps/*/*.tsbuildinfo",
    "build": "tsc -b && node tools/copy-assets.mjs",
    "typecheck": "tsc -b",
    "test": "node --test \"packages/*/dist/**/*.test.js\" \"apps/*/dist/**/*.test.js\"",
    "check:arch": "node tools/check-architecture.mjs",
    "check:arch:selftest": "node tools/check-architecture.mjs --self-test",
    "check:docs": "node tools/check-docs.mjs",
    "verify": "npm run build && npm run check:arch && npm run check:arch:selftest && npm run check:docs && npm test",
    "ai:capture": "node apps/api/dist/ai/live-capture.js",
    "eval:baseline": "node apps/api/dist/ai/baseline.js",
    "eval:extract": "node apps/api/dist/ai/extract-baseline.js",
    "start": "node apps/api/dist/main.js",
    "start:worker": "node apps/api/dist/worker.js",
    "build:assets": "node tools/copy-assets.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.6",
    "@nestjs/common": "^11.2.1",
    "@nestjs/core": "^11.2.1",
    "@nestjs/platform-express": "^11.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "4.4.3"
  }
}
